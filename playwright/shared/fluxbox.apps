# Fluxbox matches with glob, not regex.
# (name=.*) only matches titles that start with '.'; Firefox "Unnamed" does not.
# Hide fbsetbg's xmessage if it still appears; maximize every real browser window.
[app] (name=xmessage)
  [Hidden] {yes}
  [Minimized] {yes}
[end]
[app] (name=*)
  [Deco] {NONE}
  [Maximized] {yes}
[end]
